      {
        "topic": "用户对话程序链路",
        "id": "0a95ec51dbdf535b",
        "direction": 1,
        "children": [
          {
            "topic": "用户从0开始一次对话",
            "id": "0a95f02c93f128a1",
            "children": [
              {
                "topic": "用户按 Enter\n  ↓\nEditor.handleInput()\n  ↓\nEditor.submitValue()\n  ↓\nInteractiveMode.defaultEditor.onSubmit(text)\n  ↓\nInteractiveMode.getUserInput() 的 Promise 被 resolve\n  ↓\nInteractiveMode.run() 主循环取得 userInput\n  ↓\nAgentSession.prompt(userInput)\n  ↓\nAgentSession._runAgentPrompt(messages)\n  ↓\nAgent.prompt(messages)\n  ↓\nAgent.runPromptMessages(messages)\n  ↓\nAgent.runWithLifecycle(...)\n  ↓\nrunAgentLoop(...)\n  ↓\nrunLoop(...)",
                "id": "0a95f9a707d08b01"
              }
            ]
          },
          {
            "topic": "用户在已有对话的基础上开始一次对话",
            "id": "0a95f4d59c2fbd88",
            "children": [
              {
                "topic": "Editor.submitValue()\n  → InteractiveMode.onSubmit\n  → getUserInput()\n  → InteractiveMode.run()\n  → AgentSession.prompt()\n  → _runAgentPrompt()\n  → Agent.prompt()\n  → runPromptMessages()\n  → runAgentLoop()\n  → runLoop()",
                "id": "0a98bd8c73494859"
              }
            ]
          }
        ]
      }
    ]
